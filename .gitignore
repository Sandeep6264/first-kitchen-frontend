# ==================== REACT / VITE / CRA STANDARD GITIGNORE ====================

# Node modules
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build outputs
dist/
build/
.out/
.vercel/
.netlify/

# Vite specific
.vite/
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local

# But allow these if you want to commit (optional)
# !.env.example
# !.env.production

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Dependency directories
.jspm_packages/
.webassets-cache/

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Microbundle cache
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/

# IDE & Editor folders
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# React / TypeScript cache
*.tsbuildinfo

# Testing
coverage/
.nyc_output/

# Production build (if you deploy manually)
/public/build/
/public/static/

# Local Netlify or Vercel functions (if used)
.netlify/
.vercel/

# Temporary files
tmp/
temp/
*.tmp
*.temp

# Lock files (optional – usually you commit them)
/package-lock.json
/yarn.lock
/pnpm-lock.yaml
# Keep these if your team uses consistent package manager
# Remove above lines if you want to commit lock files

# React Native / Expo (if ever used)
.expo/
.expo-shared/

# End of file